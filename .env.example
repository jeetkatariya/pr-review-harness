# GitHub Personal Access Token
# Create at: https://github.com/settings/tokens/new
# Scopes needed: repo (for private repos) or public_repo (for public repos)
GITHUB_TOKEN=ghp_your_token_here

# Webhook secret — you make this up, any random string
# You'll paste the same value into your GitHub webhook settings
GITHUB_WEBHOOK_SECRET=your_random_secret_here

# Port the server listens on
PORT=3000

# ─── AI Provider ───────────────────────────────────────────────────────────────
# Set PROVIDER to "openrouter" (default, free models) or "anthropic" (paid, Claude)
PROVIDER=openrouter

# OpenRouter — used when PROVIDER=openrouter
# Get your key at: https://openrouter.ai/keys
# Free models are used by default with automatic fallback chain.
# To pin a specific model, set OPENROUTER_MODEL. Otherwise leave blank.
OPENROUTER_API_KEY=sk-or-your-key-here
# OPENROUTER_MODEL=minimax/minimax-m2.5:free

# Anthropic — used when PROVIDER=anthropic (final integration / production runs)
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
